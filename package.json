{
  "name": "vibe-governor",
  "version": "1.3.0",
  "description": "Vibe Governor web wizard + CLI: AI guidelines, Memory Bank and guard scripts for AI-assisted software and HDL projects.",
  "license": "MIT",
  "author": "SafakSahinn",
  "keywords": [
    "ai",
    "vibe-coding",
    "guidelines",
    "memory-bank",
    "claude",
    "cursor",
    "copilot",
    "verilog",
    "vhdl",
    "pre-commit"
  ],
  "homepage": "https://safaksahinn.github.io/vibe-governor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SafakSahinn/vibe-governor.git"
  },
  "bugs": {
    "url": "https://github.com/SafakSahinn/vibe-governor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "vibe-governor": "bin/vibe-governor.cjs"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --target=node18 --format=cjs --minify-whitespace --minify-syntax --legal-comments=none --outfile=bin/vibe-governor.cjs --banner:js=\"#!/usr/bin/env node\"",
    "test": "npm run build:cli && node --test tests/cli.test.mjs tests/lifecycle.test.mjs && vitest run",
    "test:ui": "vitest run"
  },
  "devDependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "framer-motion": "^11.11.11",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "next": "^16.4.3",
    "postcss": "^8.4.47",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
